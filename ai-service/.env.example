# ============================================================
# MindSpark AI Service — Environment Variables
# Sao chép file này thành .env rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file .env lên git.
# ============================================================

# --- API Keys ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Model selection (đọc từ đây, không hardcode trong code) ---
# STT model Groq Whisper
STT_MODEL=whisper-large-v3-turbo
# LLM model Gemini Flash-Lite
LLM_MODEL=gemini-3.5-flash-lite

# --- Oracle Service ---
# URL của oracle service do team Blockchain chạy
ORACLE_SERVICE_URL=http://localhost:4020
# Giá trị của INTERNAL_AI_SECRET bên oracle (header x-oracle-auth)
ORACLE_API_KEY=mindspark-internal-secret-2026
# Đặt true để dùng proof giả khi dev không có oracle thật
ORACLE_MOCK=false

# --- CORS ---
# Danh sách origin cho phép, cách nhau bởi dấu phẩy
CORS_ORIGINS=http://localhost:3000

